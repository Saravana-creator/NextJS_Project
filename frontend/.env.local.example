MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dent-ist?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret-min-32-chars
GRAPHQL_ENDPOINT=http://localhost:3000/api/graphql
NODE_ENV=development

# ─────────────────────────────────────────────
# Hardcoded admin account (3-role system)
# Roles: patient | admin | doctor
# ─────────────────────────────────────────────
# Admin: full system access — hardcoded here, auto-provisioned on first login
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@dentist.com
ADMIN_PASSWORD=YourSecureAdminPassword

# Doctors are NOT hardcoded here.
# Admin creates doctor accounts manually via /admin/doctors panel.
# Each doctor gets a hospital-issued email (e.g., vikram@citycare.com).
# Their hospital must be registered and active in the system.
